# Supabase project credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key is used ONLY by server-side routes (seed script, scheduled email job).
# Never expose this to the browser / never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (https://resend.com) API key used to send review request emails.
RESEND_API_KEY=your-resend-api-key
# Verified "from" address in Resend (e.g. reviews@yourdomain.com). Falls back to
# Resend's shared onboarding@resend.dev sender if not set, useful for demos.
EMAIL_FROM=onboarding@resend.dev

# Public URL of the deployed app. All links in customer emails are built from this.
# Defaults to https://pentriq.cloud when unset.
NEXT_PUBLIC_APP_URL=https://pentriq.cloud

# Shared secret required as a query/header param when calling the scheduled
# send endpoint (/api/send-review-requests), so it can't be triggered by anyone.
CRON_SECRET=change-me-to-a-random-string

# Admin access: if the logged-in user's email is in this list, their
# dashboard also shows a table of every registered business. Comma-separated
# for multiple admins. Must match the email(s) you actually sign up / log in
# with via the normal /login page (Supabase Auth) — not a separate password,
# just an email check on existing accounts.
ADMIN_EMAIL=admin@example.com,another-admin@example.com

# Google Business Profile integration (Settings -> Integrations).
# Create an OAuth 2.0 "Web application" client in Google Cloud Console, enable the
# Business Profile APIs (My Business Account Management, Business Information and
# the v4 reviews API - these need Google's access approval), and add
# {NEXT_PUBLIC_APP_URL}/api/google-business/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Optional: override the redirect URI (defaults to NEXT_PUBLIC_APP_URL + /api/google-business/callback).
# GOOGLE_REDIRECT_URI=
# 32-byte key that encrypts stored Google tokens (AES-256-GCM). Server-only, never commit it.
# Generate with: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32

# Set to true once Google has approved your Business Profile API access request.
# Until then Settings -> Integrations shows "Integration Coming Soon" for Google.
# GOOGLE_BUSINESS_API_APPROVED=true

# Stripe billing (Settings -> Billing). See docs/STRIPE_SETUP.md.
# Server-only secret key (sk_test_... / sk_live_...). Never expose to the browser.
STRIPE_SECRET_KEY=sk_test_your-key
# Signing secret of the webhook endpoint {NEXT_PUBLIC_APP_URL}/api/stripe/webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_your-secret
# Publishable key. Not used by the hosted Checkout flow today; reserved for future client-side Stripe.js use.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
# Comma-separated recurring monthly price ids. The FIRST is used for new checkouts.
STRIPE_PRICE_IDS=price_your-monthly-price

# Sentry error monitoring (https://sentry.io). Leave blank to disable; the app runs normally without it.
# DSN of your Sentry project (Settings → Projects → <project> → Client Keys). Use the SAME value for both.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional, build-time only: uploads source maps so stack traces show your real code, and creates a release per
# deploy. Create the token at Sentry → Settings → Developer Settings → Internal Integration (scope: Releases: Admin,
# Organization: Read). SENTRY_ORG and SENTRY_PROJECT are the slugs shown in your Sentry URLs.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# The release id is the Git commit (VERCEL_GIT_COMMIT_SHA, set automatically by Vercel). Nothing to configure.
